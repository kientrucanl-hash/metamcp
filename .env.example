# --- Meta API Configuration ---
# API Version to use (e.g. v20.0)
META_API_VERSION=v20.0

# --- General Authentication ---
# For Meta Ads: This should be a long-lived System User Access Token with ads_management and ads_read permissions.
# For Messenger/WhatsApp: This can be your Page Access Token or a System User Access Token with appropriate business messaging permissions.
META_ACCESS_TOKEN=your_meta_access_token_here

# --- Meta Ads ---
# Facebook Ad Account ID, must include 'act_' prefix (e.g. act_1234567890)
META_AD_ACCOUNT_ID=act_your_ad_account_id_here

# --- Meta Messenger ---
# Facebook Page ID for Messenger integrations
META_PAGE_ID=your_facebook_page_id_here

# --- Meta WhatsApp ---
# WhatsApp Phone Number ID (from Meta Developer Console)
META_WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# WhatsApp Business Account ID (from Meta Developer Console)
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
